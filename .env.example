# ============================================
# XR Research Lab — Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env with real credentials.
# ============================================

# --- Supabase ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Admin Credentials ---
# Generate hash: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(h=>console.log(h))"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=$2a$12$...

# --- Cloudflare Turnstile CAPTCHA ---
TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# --- Resend Email ---
RESEND_API_KEY=re_...

# --- Session Security ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_SESSION_SECRET=your-64-char-hex-secret

# --- Admin Notification Email ---
# The email address where OTP codes are sent (the admin's email)
ADMIN_NOTIFY_EMAIL=xrresearchlab@gcet.edu.in
